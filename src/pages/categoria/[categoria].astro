---
import Layout from '../../layouts/Layout.astro';
import LiveFullDaysGrid from '../../components/LiveFullDaysGrid.astro';
import { obtenerFullDaysActivos, type FullDayViaje } from '../../services/fullDayService';

export async function getStaticPaths() {
  const fullDays = await obtenerFullDaysActivos();

  return [
    {
      params: { categoria: 'fullday' },
      props: {
        categoria: 'fullday',
        fullDays,
      },
    },
  ];
}

interface Props {
  categoria: string;
  fullDays: FullDayViaje[];
}

const { fullDays = [] } = Astro.props;
---

<Layout title="Paseos por el Día" description="Conocé nuestros Paseos por el Día. Salidas en el día con coordinación y actividades incluidas.">
  <div class="detail-header">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Inicio</a> ➔ <span>PASEOS POR EL DÍA</span>
      </div>
      <h1 style="font-size: 2.2rem; font-weight: 800;">🚌 Paseos por el Día</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted);">
        Encontramos {fullDays.length} opción(es) activas para tus próximas salidas.
      </p>
    </div>
  </div>

  <section style="padding: 50px 0 70px 0;">
    <div class="container">
      <LiveFullDaysGrid initialViajes={fullDays} />
    </div>
  </section>
</Layout>
