---
import CardFullDay from './CardFullDay.astro';
import type { FullDayViaje } from '../services/fullDayService';

interface Props {
  initialViajes?: FullDayViaje[];
}

const { initialViajes = [] } = Astro.props;
---

<div id="fullday-grid" class="grid">
  {initialViajes.length > 0 ? (
    initialViajes.map((viaje) => (
      <CardFullDay viaje={viaje} />
    ))
  ) : (
    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: white; border-radius: var(--radius); border: 1px solid var(--border);">
      <p style="font-size: 1.1rem; color: var(--text-muted);">No hay salidas Full Day activas en este momento. ¡Consultanos por WhatsApp para próximas fechas!</p>
    </div>
  )}
</div>

<script>
  const SPREADSHEET_ID = '1PQcS03Qs4Jl-U8UX4-RLRMtgntdW8DwXbL_FZsXanf8';
  const SHEET_NAME = 'API_Data';
  const GOOGLE_GVIZ_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:json&sheet=${SHEET_NAME}`;
  const OPENSHEET_URL = `https://opensheet.elk.sh/${SPREADSHEET_ID}/${SHEET_NAME}`;
  const DEFAULT_IMAGE = 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=800&q=80';

  function normalizarImagen(url: string | undefined): string {
    if (!url || typeof url !== 'string' || url.trim() === '') {
      return DEFAULT_IMAGE;
    }
    const cleanUrl = url.trim();
    // Google Drive
    const driveRegex = /(?:drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?id=|thumbnail\?id=))([a-zA-Z0-9_-]+)/;
    const match = cleanUrl.match(driveRegex);
    if (match && match[1]) {
      return `https://lh3.googleusercontent.com/d/${match[1]}`;
    }
    return cleanUrl;
  }

  function resolverTipoViaje(tipoRaw: string | undefined): { tipoViaje: string; tagTipoViaje: string } {
    const raw = (tipoRaw || '').toString().trim();
    const lower = raw.toLowerCase();

    if (lower === 'viaje' || lower.includes('viaje')) {
      return { tipoViaje: 'Viaje', tagTipoViaje: '🚌 Viaje' };
    }
    if (lower === 'full day' || lower === 'fullday' || lower.includes('full')) {
      return { tipoViaje: 'Full Day', tagTipoViaje: '🚌 Full Day' };
    }
    if (raw.length > 0) {
      return { tipoViaje: raw, tagTipoViaje: `🚌 ${raw}` };
    }
    return { tipoViaje: 'Full Day', tagTipoViaje: '🚌 Full Day' };
  }

  function parsearIncluye(incluye: string | undefined): string[] {
    if (!incluye) return [];
    return incluye
      .split(/[,•;-]+/)
      .map((item) => item.trim())
      .filter((item) => item.length > 0);
  }

  async function fetchDatosGoogleSheets(): Promise<any[]> {
    try {
      // 1. Consulta directa a Google Sheets (0 segundos de caché, actualización instantánea)
      const gvizRes = await fetch(`${GOOGLE_GVIZ_URL}&_nocache=${Date.now()}`);
      if (gvizRes.ok) {
        const text = await gvizRes.text();
        const jsonStr = text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1);
        const json = JSON.parse(jsonStr);
        const headers = json.table.cols.map((c: any) => (c.label || '').trim());
        const rows = json.table.rows.map((r: any) => {
          const obj: Record<string, any> = {};
          headers.forEach((header: string, i: number) => {
            if (!header) return;
            const cell = r.c && r.c[i];
            obj[header] = cell
              ? cell.f !== undefined && cell.f !== null
                ? cell.f
                : cell.v !== undefined && cell.v !== null
                ? cell.v
                : ''
              : '';
          });
          return obj;
        });
        return rows;
      }
    } catch (e) {
      console.warn('Fallback a OpenSheet...');
    }

    // 2. Fallback a OpenSheet
    try {
      const openSheetRes = await fetch(`${OPENSHEET_URL}?_nocache=${Date.now()}`);
      if (openSheetRes.ok) {
        return await openSheetRes.json();
      }
    } catch (e) {
      console.error('Error al consultar OpenSheet:', e);
    }

    return [];
  }

  async function sincronizarViajesDesdeSheet() {
    const grid = document.getElementById('fullday-grid');
    if (!grid) return;

    try {
      const data = await fetchDatosGoogleSheets();
      if (!Array.isArray(data)) return;

      // Filtrar estrictamente solo los viajes cuyo Estado sea "Activo" (ignorando mayúsculas/minúsculas y espacios)
      const activos = data.filter((v: any) => {
        const estado = (v.Estado || '').toString().trim().toLowerCase();
        return estado === 'activo';
      });

      if (activos.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: white; border-radius: var(--radius); border: 1px solid var(--border);">
            <p style="font-size: 1.1rem; color: var(--text-muted);">No hay salidas Full Day activas en este momento. ¡Consultanos por WhatsApp para próximas fechas!</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = activos.map((viaje: any, index: number) => {
        const rawTipo =
          viaje['Tipo de Viaje'] ||
          viaje['Tipo de viaje'] ||
          viaje['Tipo De Viaje'] ||
          viaje['tipo de viaje'] ||
          viaje['Tipo'] ||
          viaje['tipo'] ||
          viaje['TipoViaje'] ||
          viaje['tipoViaje'];
        const { tipoViaje, tagTipoViaje } = resolverTipoViaje(rawTipo);
        const destino = (viaje.Destino || '').toString().trim() || `${tipoViaje} #${index + 1}`;
        const fecha = (viaje.Fecha || '').toString().trim() || 'Próximamente';
        const precio = (viaje.Precio || '').toString().trim() || 'Consultar';
        const incluye = (viaje.Incluye || '').toString().trim() || 'Coordinación y traslados';
        const incluyeLista = parsearIncluye(incluye);
        const imagenUrl = normalizarImagen(viaje['URL Imagen']);

        const pillsHtml = incluyeLista.length > 0
          ? incluyeLista.map((item) => `<span class="include-pill">✓ ${item}</span>`).join('')
          : `<span class="include-pill">✓ ${incluye}</span>`;

        return `
          <article class="card card-fullday">
            <div class="card-img-wrapper">
              <img 
                src="${imagenUrl}" 
                alt="${tipoViaje} a ${destino}" 
                loading="lazy" 
                referrerpolicy="no-referrer"
                onerror="this.onerror=null; this.src='${DEFAULT_IMAGE}';"
              />
              <span class="card-tag">${tagTipoViaje}</span>
              <span class="card-badge-status">🟢 Cupos Disponibles</span>
            </div>

            <div class="card-body">
              <h3 class="card-title fullday-title">${destino}</h3>

              <div class="fullday-date-badge">
                <span class="date-icon">📅</span>
                <div>
                  <small class="date-label">Fecha de Salida</small>
                  <div class="date-val">${fecha}</div>
                </div>
              </div>

              <div class="fullday-includes-box">
                <div class="includes-title">✨ Incluye:</div>
                <div class="includes-tags">
                  ${pillsHtml}
                </div>
              </div>

              <div class="card-footer fullday-footer">
                <div class="price-container">
                  <div class="price-label">Tarifa por persona</div>
                  <div class="price-val fullday-price">${precio}</div>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join('');

    } catch (error) {
      console.warn('Error al sincronizar viajes en tiempo real:', error);
    }
  }

  // Ejecutar inmediatamente cada vez que se carga / recarga la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sincronizarViajesDesdeSheet);
  } else {
    sincronizarViajesDesdeSheet();
  }
</script>
